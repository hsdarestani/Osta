{
  "name": "bavaan-ai",
  "version": "0.1.0",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "start": "node server.js",
    "check": "node --check server.js",
    "build:landing": "mkdir -p public/landing && esbuild src/saas-landing.tsx --bundle --minify --outfile=public/landing/app.js --format=iife --jsx=automatic && tailwindcss -c tailwind.config.js -i ./src/landing.css -o ./public/landing/app.css --minify"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
